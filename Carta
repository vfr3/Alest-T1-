public class Carta {
    int valor; 
    String naipe;
    
    public Carta(int valor, String naipe) {
        this.valor =valor;
        this.naipe = naipe;
    }

    public int getValor() {
        return valor;
    }
    public void setValor(int valor) {
        this.valor = valor;
    }

    @Override
    public String toString() {
        return valor + " de "+ naipe;
    }
}
